# macOS
.DS_Store

# Xcode 用户级状态：只反映「谁打开了哪个文件、断点在哪」，与工程配置无关，
# 跟踪它会在每次开关 Xcode 后产生无意义的 diff
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# 构建产物
build/
DerivedData/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.moved-aside

# Swift Package Manager（本项目不使用依赖管理，仅防止 Xcode 自动生成的缓存入库）
.build/
.swiftpm/

# Playground / Instruments
timeline.xctimeline
playground.xcworkspace
*.trace
